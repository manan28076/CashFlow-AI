generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  password              String?
  googleId              String?               @unique
  name                  String?
  avatarUrl             String?
  plan                  String                @default("STARTER") // "STARTER" | "PRO" | "FAMILY"
  planBillingCycle      String?               // "monthly" | "annual"
  subscriptionStatus    String                @default("INACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELLED" | "INACTIVE"
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  createdAt             DateTime              @default(now())
  accounts              Account[]
  budgets               Budget[]
  monthlyBudgets        MonthlyBudget[]
  payments              SubscriptionPayment[]
  aiCallLogs            AiCallLog[]
  merchantRules         MerchantRule[]
  pendingAiActions      PendingAiAction[]
  notifications         Notification[]
}

model SubscriptionPayment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   // "PRO" | "FAMILY"
  billingCycle      String   // "monthly" | "annual"
  amount            Float    // in INR
  currency          String   @default("INR")
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  status            String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  startedAt         DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Account {
  id          String   @id @default(cuid())
  name        String
  bankName    String
  createdAt   DateTime @default(now())

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

model Category {
  id           String          @id @default(cuid())
  name         String          @unique
  type         TransactionType @default(EXPENSE)

  transactions Transaction[]
  budgets      Budget[]
  merchantRules MerchantRule[]
}

model Transaction {
  id          String            @id @default(cuid())
  date        DateTime
  description String
  merchant    String?
  note        String?
  amount      Float
  type        TransactionType
  isAnomaly   Boolean           @default(false)
  hash        String?
  createdAt   DateTime          @default(now())

  accountId   String
  account     Account           @relation(fields: [accountId], references: [id])

  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id])

  @@index([accountId, hash])
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float

  month      Int
  year       Int

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  amount    Float
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model AiCallLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent            String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  errorType        String?
  retries          Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agent, createdAt])
}

enum MerchantRuleSource {
  USER
  LLM
}

model MerchantRule {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey String
  categoryId  String
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  source      MerchantRuleSource
  hitCount    Int                @default(1)
  lastUsedAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, merchantKey])
  @@index([userId, merchantKey])
}

model PendingAiAction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String
  argsJson  String
  status    String   @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED" | "EXPIRED"
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  dataJson  Json?
  weekKey   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, type, weekKey])
  @@index([userId, readAt])
}